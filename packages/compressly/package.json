{
  "name": "compressly",
  "version": "0.1.1",
  "description": "Compress and resize images in the browser before upload: target file size, max width, WebP/JPEG, EXIF rotation, batch + Web Worker. Zero deps, ~2.2 KB.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Mostafa Mohamed Abdalla (https://github.com/Mostafashadow1)",
  "homepage": "https://compress-ly.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mostafashadow1/compressly.git",
    "directory": "packages/compressly"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/Mostafashadow1/compressly/issues"
  },
  "keywords": [
    "image-compression",
    "compress-image",
    "image-resize",
    "resize-image",
    "image-upload",
    "upload",
    "webp",
    "jpeg",
    "exif",
    "browser",
    "client-side",
    "web-worker",
    "offscreen-canvas",
    "react",
    "nextjs",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "happy-dom": "^20.14.5",
    "react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
