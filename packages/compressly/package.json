{
  "name": "compressly",
  "version": "0.1.0",
  "description": "Zero-dependency, ultra-fast client-side image compression and optimization library for Next.js, React, Vue, Svelte and Vanilla JS with Web Worker support",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Mostafa Mohamed Abdalla (https://github.com/Mostafashadow1)",
  "homepage": "https://compress-ly.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mostafashadow1/compressly.git"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/Mostafashadow1/compressly/issues"
  },
  "keywords": [
    "image-compression",
    "image-optimizer",
    "client-side",
    "browser",
    "canvas",
    "offscreen-canvas",
    "web-worker",
    "exif",
    "nextjs",
    "react",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "files": [
    "assets",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/react/index.ts --format esm,cjs --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "happy-dom": "^20.14.5",
    "react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
